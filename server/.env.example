MONGODB_URI=<your-mongodb-atlas-connection-string>
PORT=3001

# Single-user login credential. AUTH_PASSWORD_HASH is a bcrypt hash, never
# a plaintext password — generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_ID=<your-chosen-login-id>
AUTH_PASSWORD_HASH=<bcrypt-hash-of-your-password>
AUTH_JWT_SECRET=<a-long-random-string>

# Must match the origin the client is served from — required for the
# session cookie to be sent cross-origin (credentials: true).
CLIENT_ORIGIN=http://localhost:5173

# Set to "true" once served over HTTPS in a real deployment.
COOKIE_SECURE=false
